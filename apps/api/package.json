{
  "name": "@orkide/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./client": {
      "types": "./dist/types/apps/api/src/client.d.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "dev": "node scripts/require-dev-vars.ts && vite dev",
    "build": "vite build",
    "preview": "node scripts/require-dev-vars.ts dist/orkide_api/.dev.vars && vite preview",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "tsc -p tsconfig.types.json",
    "db:seed:e2e": "wrangler d1 execute DB --local --file seed/e2e.sql"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@orkide/auth": "workspace:*",
    "@orkide/content": "workspace:*",
    "@orkide/db": "workspace:*",
    "@orkide/email": "workspace:*",
    "@orkide/i18n": "workspace:*",
    "@orkide/logger": "workspace:*",
    "@orkide/validators": "workspace:*",
    "@scalar/hono-api-reference": "catalog:",
    "drizzle-orm": "catalog:",
    "file-type": "catalog:",
    "hono": "catalog:",
    "resend": "catalog:",
    "zod": "catalog:",
    "@orkide/billing": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@orkide/config": "workspace:*",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}